<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <connectionStrings>
    <!-- DbRuleEngein — XmlBody / RuleClass -->
    <add name="RuleEngine"
         connectionString="Server=tcp:172.16.8.136;Database=DbRuleEngein;User Id=hService;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
    <!-- Sara8M03 — پرونده، صلح، ضابطه -->
    <add name="Sara"
         connectionString="Server=tcp:172.16.8.136;Database=Sara8M03;User Id=hService;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
    <!-- بعضی DLLها ممکن است نام دیگری انتظار داشته باشند — در صورت خطا از web.config Sara کپی کنید -->
    <add name="Sara8M03"
         connectionString="Server=tcp:172.16.8.136;Database=Sara8M03;User Id=hService;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- مسیر DLLهای شهرسازی -->
    <add key="DllPath" value="C:\Users\sadathoseini-sh\Desktop\dll10" />
    <!-- از web.config / app.config Sara کپی کنید — پارامتر دوم ClsCommon.RunRule -->
    <add key="RootGUID" value="00000000-0000-0000-0000-000000000000" />
    <!-- شهر پیش‌فرض (مشهد = 2) -->
    <add key="DefaultCity" value="2" />
  </appSettings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="dll10" />
    </assemblyBinding>
  </runtime>
</configuration>
