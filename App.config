<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!-- Defaults only. Values edited in the UI are saved to bin\RuleTrace.user.ini and override these. -->
  <connectionStrings>
    <add name="RuleEngine"
         connectionString="Server=tcp:172.16.10.232;Database=DbRuleEngein;User Id=debugger;Password=Ra@123456;TrustServerCertificate=True;Encrypt=False;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
    <add name="Sara"
         connectionString="Server=tcp:172.16.10.232;Database=Sara8M03;User Id=debugger;Password=Ra@123456;TrustServerCertificate=True;Encrypt=False;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Folder with BIZ.SC.DLL, BIZ.SA.DLL, SafaClassDesingerNew.dll. Auto-detected if empty. -->
    <add key="DllPath" value="C:\Users\sadathoseini-sh\Desktop\dll10" />
    <!-- vbc inside SafaClassDesingerNew references c:\dll10 — RuleTrace syncs DllPath there on each run -->
    <add key="LegacyCompileDllPath" value="c:\dll10" />
    <!-- NidCity of Mashhad (CI_City.ID = 2). Resolved from Sara8M03 if empty. -->
    <add key="CityGuid" value="06065CA7-8B68-491F-A002-2AC9CAC8AE34" />
    <add key="DefaultCity" value="2" />
    <!-- Local compile cache built on this PC: {FormulaCachePath}\{CityGuid}\{NidRuleClass}\ -->
    <add key="FormulaCachePath" value="C:\Users\sadathoseini-sh\Desktop\dll10\SafaFormulaCache" />
  </appSettings>
</configuration>
